# ── Wick Fair Market — testnet environment ─────────────────────────────────────
# Copy to .env and fill in the blanks.  Never commit .env to git.

# Stellar network
NETWORK=testnet
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deployer / admin keypair — fund from https://friendbot.stellar.org
ADMIN_SECRET=S...
ADMIN_ADDRESS=G...

# Contract addresses (populated after deploy-testnet.sh runs)
CONTRACT_ID=

# Reflector ReflectorPulse oracle — USD-base, BTC/ETH/SOL, free, 5-min
# Source: https://orchestrator-testnet.reflector.network/config
ORACLE_ADDRESS=CCYOZJCOPG34LLQQ7N24YXBM7LL62R7ONMZ3G6WZAAYPB5OYKOMJRN63

# XLM Stellar Asset Contract on testnet
# Derived by: stellar contract id asset --asset native --network testnet
XLM_SAC_ADDRESS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Treasury address — receives swept fees
TREASURY_ADDRESS=G...

# Contract parameters
FEE_BPS=200            # 2% — max 500
MIN_BET_STROOPS=100000000   # 10 XLM in stroops
LOCK_OFFSET_SECS=180   # 3 minutes (min 90)

# Keeper config
KEEPER_OFFSET_MS=5000  # fire 5s after each 5-min boundary
ALERT_WEBHOOK_URL=

# Indexer / API
DATABASE_URL=postgresql://localhost:5432/wick
API_PORT=3000
